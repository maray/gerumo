{
    "model_name": "CNN_DET_UNIT_MST_NectarCam_DL1_V1_log10_energy",
    "model_constructor": "cnn_det_unit",
    "assembler_constructor": "cnn_det",
    "model_extra_params": {
        "latent_variables": 600
    },
    "telescope" : "MST_NectarCam",
    "output_folder" : "./output/Training gamma-diffuse/CNN-DET/log10_energy",
    
    "version": "DL1",
    "train_events_csv"    : "../dataset/gamma-diffuse only/train_events.csv",
    "train_telescope_csv" : "../dataset/gamma-diffuse only/train_telescopes.csv",
    "replace_folder_train" : null,
    "validation_events_csv"    : "../dataset/gamma-diffuse only/validation_events.csv",
    "validation_telescope_csv" : "../dataset/gamma-diffuse only/validation_telescopes.csv",
    "replace_folder_validation" : null,
    "test_events_csv"    : "../dataset/gamma-diffuse only/test_events.csv",
    "test_telescope_csv" : "../dataset/gamma-diffuse only/test_telescopes.csv",
    "replace_folder_test" : null,
    
    "input_image_mode" : "simple-shift",
    "input_image_mask" : true,
    "min_observations" : 1,
    "input_features" : ["x", "y"],
    
    "targets" : ["log10_mc_energy"],
    "target_mode" : "lineal",
    "target_shapes" : {
        "alt": 81, 
        "az": 81, 
        "log10_mc_energy": 81
    },
    "target_domains" : {
        "alt": [1.15, 1.3], 
        "az": [-0.25, 0.25], 
        "log10_mc_energy": [-2.351, 2.47]
    },
    "target_sigmas" : null,
 
    "preprocessing": {
        "CameraPipe" : {
            "charge_scaler_value" : 62.652400970459,
            "peak_scaler_path" : "DL1_MST_NectarCam_peak_scaler",
            "tailcuts_clean_params": {"boundary_thresh": 6, "picture_thresh": 14}
        },
        "TelescopeFeaturesPipe": {
            "array_scaler_path": "DL1_array-scaler"
        }
    },

    "use_multiprocessing" : false,
    "workers" : 10,
    "max_queue_size" : 8,
    "batch_size" : 128,             
    "epochs" : 50,
    "loss" : "mse",
    "optimizer": {
        "learning_rate": 1e-3,
        "name": "adam",
        "extra_parameters": null
    },
  
    "save_checkpoints" : true,
    "save_predictions" : false,
    "save_regressions" : false,
    "save_loss"        : true,
    

    "summary" : false,
    "plot_only" : false,
    "save_plot" : false
 }
